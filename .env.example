# Copy this file to .env and replace placeholder values.
# Never commit real API keys, production callback URLs, or customer data.

APIDOT_API_KEY=YOUR_APIDOT_API_KEY
APIDOT_BASE_URL=https://api.apidot.ai

# Optional. Uncomment only when you have a real public webhook receiver.
# APIDOT_CALLBACK_URL=https://example.com/api/apidot/webhook

# Optional. Comma-separated task ids that your webhook receiver is allowed to process.
# In production, use a database lookup instead of an environment variable.
APIDOT_KNOWN_TASK_IDS=task-unified-example

PORT=3000
